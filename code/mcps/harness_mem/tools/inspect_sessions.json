{
  "name": "inspect_sessions",
  "description": "Read-only device-session inventory, source pages, themes or frozen-batch progress. Missing/absent/multiple workspace roots are valid; directories are optional. Discovery refs are not immutable revisions: prepare fully reads and freezes selected sources. No imports, jobs, memory writes or background work.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "all",
          "project"
        ],
        "description": "All device sessions by default; project is an explicitly requested optional source filter."
      },
      "project_root": {
        "type": "string",
        "description": "Optional source filter, including a historical missing directory. Omit for all device sessions. Do not ask users to fill this field."
      },
      "project_name": {
        "type": "string",
        "description": "Optional context label; historical source roots never reserve this name. Selected sources are independently validated within their root."
      },
      "action": {
        "type": "string",
        "enum": [
          "inventory",
          "source",
          "overview"
        ],
        "default": "inventory"
      },
      "clients": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "cursor",
            "grok",
            "hermes",
            "opencode",
            "antigravity"
          ]
        }
      },
      "session": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "reference_id": {
            "type": "string"
          },
          "project_root": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "project"
            ]
          }
        },
        "required": [
          "client",
          "session_id",
          "source_id",
          "source_revision",
          "reference_id"
        ]
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "page_chars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "default": 16000
      },
      "batch_id": {
        "type": "string",
        "description": "Read progress of an existing frozen manual batch"
      },
      "sessions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "client": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "source_revision": {
              "type": "string"
            },
            "reference_id": {
              "type": "string"
            },
            "project_root": {
              "type": "string"
            },
            "project_name": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "all",
                "project"
              ]
            }
          },
          "required": [
            "client",
            "session_id",
            "source_id",
            "source_revision",
            "reference_id"
          ]
        },
        "description": "Fixed source scope for a read-only theme overview"
      },
      "coverage": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reference_id": {
              "type": "string"
            },
            "content_sha256": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "reference_id",
            "content_sha256",
            "offset",
            "end"
          ]
        },
        "description": "Ranges returned by source pages that the Agent completely read"
      },
      "topics": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference_id": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "reference_id",
                  "start",
                  "end"
                ]
              }
            }
          },
          "required": [
            "name",
            "evidence"
          ]
        },
        "description": "Agent-proposed themes with source locations; multiple themes per session are allowed"
      }
    },
    "required": []
  }
}
