#!/usr/bin/env python3
"""Generated Codex Stop hook wrapper for harness-mem."""

from __future__ import annotations

import json
import subprocess
import sys

PROJECT_ROOT = ${PROJECT_ROOT_JSON}


def _trigger_id() -> str:
    try:
        payload = json.load(sys.stdin)
    except Exception:  # noqa: BLE001 - fail open for passive hooks.
        return "codex-stop"
    value = payload.get("turn_id") or payload.get("session_id") or "codex-stop"
    return str(value)


def main() -> int:
    result = subprocess.run(
        [
            sys.executable,
            "-m",
            "harness_mem.host_entry",
            "--action",
            "post-turn-maintenance",
            "--project-root",
            PROJECT_ROOT,
            "--source",
            "ide_hook",
            "--trigger-id",
            _trigger_id(),
        ],
        capture_output=True,
        check=False,
        text=True,
    )
    if result.stderr:
        sys.stderr.write(result.stderr)
    sys.stdout.write("{}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
