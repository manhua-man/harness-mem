import type { Plugin } from "@opencode-ai/plugin"

const projectRoot = ${PROJECT_ROOT_JSON}
const hookRunner = ${HOOK_RUNNER_JSON}

async function withHarnessMemClient<T>(clientName: string, fn: () => Promise<T>): Promise<T> {
  const previous = process.env.HARNESS_MEM_CLIENT
  process.env.HARNESS_MEM_CLIENT = clientName
  try {
    return await fn()
  } finally {
    if (previous === undefined) {
      delete process.env.HARNESS_MEM_CLIENT
    } else {
      process.env.HARNESS_MEM_CLIENT = previous
    }
  }
}

async function runWakeStart($$: any): Promise<string> {
  return withHarnessMemClient("opencode", async () => {
    try {
      return await $$`$${hookRunner} --action wake-start --project-root $${projectRoot} --source ide_hook --trigger-id opencode-session-created --client opencode`.text()
    } catch {
      return ""
    }
  })
}

async function runPostTurnMaintenance($$: any, triggerId: string): Promise<void> {
  await withHarnessMemClient("opencode", async () => {
    try {
      await $$`$${hookRunner} --action post-turn-maintenance --project-root $${projectRoot} --source ide_hook --trigger-id $${triggerId} --client opencode`.quiet()
    } catch {
      // OpenCode plugin hooks are best-effort.
    }
  })
}

const plugin: Plugin = async ({ $$, client }) => ({
  event: async ({ event }: { event: { type?: string } }) => {
    const type = event?.type ?? ""
    if (type === "session.created") {
      const wakeText = (await runWakeStart($$)).trim()
      const tui = (client as { tui?: { appendPrompt?: (text: string) => Promise<void> } }).tui
      if (wakeText && tui?.appendPrompt) {
        await tui.appendPrompt(`$${wakeText}\n\n`)
      }
      return
    }

    if (type === "session.idle") {
      await runPostTurnMaintenance($$, "opencode-session-idle")
    }
  },
})

export default plugin
