#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Claude Code session-start wake hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook prints wake context for session-start injection. It is read-only
# apart from wake-surfaced usage signals and never runs dream maintenance.

set -e

PROJECT_ROOT=${PROJECT_ROOT_SHELL}
TURN_ID="$${CLAUDE_CODE_TURN_ID:-session-start}"

if [ "$${HARNESS_MEM_HOOK_DEBUG:-0}" = "1" ]; then
    HARNESS_MEM_CLIENT=claude-code ${HOOK_RUNNER_SHELL} \
        --action wake-start \
        --project-root "$$PROJECT_ROOT" \
        --source ide_hook \
        --trigger-id "$$TURN_ID" \
        --client claude-code || {
            STATUS=$$?
            echo "harness-mem-hook failed (client=claude-code action=wake-start status=$$STATUS)" >&2
        }
else
    HARNESS_MEM_CLIENT=claude-code ${HOOK_RUNNER_SHELL} \
        --action wake-start \
        --project-root "$$PROJECT_ROOT" \
        --source ide_hook \
        --trigger-id "$$TURN_ID" \
        --client claude-code \
        2>/dev/null || true
fi

exit 0
