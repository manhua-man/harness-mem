#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Cursor after-agent hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook invokes the v2.4.1 host entry. By default, triggers are 'off' and
# this hook will exit 0 without running reflection. To opt in for this project:
#
#     harness-mem config set triggers.after_agent on --scope project
#
# To remove this hook, delete this file. Reinstall via:
#
#     harness-mem integration install-cursor-hook --force

set -e

PROJECT_ROOT="${PROJECT_ROOT}"
TURN_ID="$${CURSOR_TURN_ID:-unknown}"

python -m harness_mem.host_entry \
    --project-root "$$PROJECT_ROOT" \
    --source ide_hook \
    --trigger-id "$$TURN_ID" \
    --session-ids "$${CURSOR_SESSION_ID:-}" \
    >/dev/null 2>&1 || true

exit 0
