#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Cursor after-agent hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook runs one gated dream maintenance tick after an agent turn.
#
# To remove this hook, delete this file. Reinstall via:
#
#     harness-mem integration install-cursor-hook --force

set -e

PROJECT_ROOT="${PROJECT_ROOT}"
TURN_ID="$${CURSOR_TURN_ID:-unknown}"

python -m harness_mem.host_entry \
    --action dream-end \
    --project-root "$$PROJECT_ROOT" \
    --source ide_hook \
    --trigger-id "$$TURN_ID" \
    >/dev/null 2>&1 || true

exit 0
