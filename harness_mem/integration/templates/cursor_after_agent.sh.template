#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Cursor after-agent hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook runs post-turn maintenance after an agent turn.
#
# To remove this hook, delete this file. Reopen the workspace to let the MCP
# bootstrap restore missing project-local hooks.

set -e

PROJECT_ROOT=${PROJECT_ROOT_SHELL}
TURN_ID="$${CURSOR_TURN_ID:-unknown}"

if [ "$${HARNESS_MEM_HOOK_DEBUG:-0}" = "1" ]; then
    HARNESS_MEM_CLIENT=cursor python -m harness_mem.host_entry \
        --action post-turn-maintenance \
        --project-root "$$PROJECT_ROOT" \
        --source ide_hook \
        --trigger-id "$$TURN_ID" \
        >/dev/null || {
            STATUS=$$?
            echo "harness_mem.host_entry failed (client=cursor action=post-turn-maintenance status=$$STATUS)" >&2
        }
else
    HARNESS_MEM_CLIENT=cursor python -m harness_mem.host_entry \
        --action post-turn-maintenance \
        --project-root "$$PROJECT_ROOT" \
        --source ide_hook \
        --trigger-id "$$TURN_ID" \
        >/dev/null 2>&1 || true
fi

exit 0
