#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Cursor session-start wake hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook prints wake context plus a bounded Agent maintenance offer. The
# hook never performs semantic distill or dream work itself.

set -e

PROJECT_ROOT=${PROJECT_ROOT_SHELL}
# Native JSON on stdin carries the actual session identity.

if [ "$${HARNESS_MEM_HOOK_DEBUG:-0}" = "1" ]; then
    HARNESS_MEM_CLIENT=cursor ${HOOK_RUNNER_SHELL} \
        --adapter cursor-start \
        --project-root "$$PROJECT_ROOT" \
        || {
            STATUS=$$?
            echo "harness-mem-hook failed (client=cursor action=wake-start status=$$STATUS)" >&2
        }
else
    HARNESS_MEM_CLIENT=cursor ${HOOK_RUNNER_SHELL} \
        --adapter cursor-start \
        --project-root "$$PROJECT_ROOT" \
        2>/dev/null || true
fi

exit 0
