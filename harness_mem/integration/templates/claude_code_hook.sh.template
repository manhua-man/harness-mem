#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Claude Code after-turn hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook runs post-turn maintenance after a turn.
#
# To remove this hook, delete this file. Reinstall via:
#
#     harness-mem integration install-claude-suite --force

set -e

PROJECT_ROOT=${PROJECT_ROOT_SHELL}
TURN_ID="$${CLAUDE_CODE_TURN_ID:-unknown}"

HARNESS_MEM_CLIENT=claude-code python -m harness_mem.host_entry \
    --action post-turn-maintenance \
    --project-root "$$PROJECT_ROOT" \
    --source ide_hook \
    --trigger-id "$$TURN_ID" \
    >/dev/null 2>&1 || true

exit 0
