#!/usr/bin/env bash
# harness-mem ${HARNESS_MEM_VERSION} — Claude Code after-turn hook
# Generated at: ${GENERATED_AT}
# Docs: ${DOC_POINTER}
#
# This hook runs post-turn maintenance after a turn.
#
# Hook registration is maintained by explicit integration repair.

set -e

PROJECT_ROOT=${PROJECT_ROOT_SHELL}
# Native JSON on stdin carries the actual session identity.
STATUS=0

if [ "$${HARNESS_MEM_HOOK_DEBUG:-0}" = "1" ]; then
    HARNESS_MEM_CLIENT=claude-code ${HOOK_RUNNER_SHELL} \
        --adapter claude-code-stop \
        --project-root "$$PROJECT_ROOT" \
        >/dev/null || {
            STATUS=$$?
            echo "harness-mem-hook failed (client=claude-code action=post-turn-maintenance status=$$STATUS)" >&2
        }
else
    HARNESS_MEM_CLIENT=claude-code ${HOOK_RUNNER_SHELL} \
        --adapter claude-code-stop \
        --project-root "$$PROJECT_ROOT" \
        >/dev/null 2>&1 || STATUS=$$?
fi

exit "$$STATUS"
