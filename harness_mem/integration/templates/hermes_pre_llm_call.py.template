#!/usr/bin/env python3
"""Generated Hermes pre_llm_call wrapper for harness-mem."""

from __future__ import annotations

import json
import subprocess
import sys

PROJECT_ROOT = ${PROJECT_ROOT_JSON}


def _trigger_id() -> str:
    try:
        payload = json.load(sys.stdin)
    except Exception:  # noqa: BLE001 - fail open for passive hooks.
        return "hermes-pre-llm"
    extra = payload.get("extra")
    extra_dict = extra if isinstance(extra, dict) else {}
    value = payload.get("session_id") or extra_dict.get("task_id") or "hermes-pre-llm"
    return str(value)


def main() -> int:
    result = subprocess.run(
        [
            sys.executable,
            "-m",
            "harness_mem.host_entry",
            "--action",
            "wake-start",
            "--project-root",
            PROJECT_ROOT,
            "--source",
            "ide_hook",
            "--trigger-id",
            _trigger_id(),
        ],
        capture_output=True,
        check=False,
        text=True,
    )
    if result.stderr:
        sys.stderr.write(result.stderr)
    context = result.stdout.rstrip("\n")
    if context:
        sys.stdout.write(json.dumps({"context": context}) + "\n")
    else:
        sys.stdout.write("{}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
