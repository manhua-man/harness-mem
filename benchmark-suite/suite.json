    {
      "id": "memory_shortcut_vs_source_recovery",
      "title": "Memory Shortcut vs Source Recovery",
      "purpose": "Measure whether accepted memory packets reduce token/source-reading cost on long-source recovery tasks while preserving answer correctness.",
      "proves": [
        "bounded token/source-reading shortcut evidence when long-source tasks pass in both conditions",
        "memory packet usefulness only when source verification still succeeds",
        "negative controls where memory should not show a meaningful advantage"
      ],
      "does_not_prove": [
        "global token/cost savings",
        "real billing savings",
        "answer quality improvements on fresh local debugging tasks",
        "savings when memory tools are unavailable or stale"
      ],
      "artifact_requirements": [
        "run_manifest.json",
        "report.md",
        "results",
        "transcripts",
        "notes"
      ],
      "required_result_fields": [
        "task_id",
        "condition",
        "client",
        "model",
        "workspace_path",
        "runtime_seconds",
        "prompt_turns",
