    {
      "id": "true_hybrid_retrieval_shootout",
      "title": "True Hybrid Retrieval Shootout",
      "purpose": "Compare FTS baseline, vector baseline, and hybrid retrieval on source-hit recall, latency, token/cost estimate, and fallback accounting.",
      "proves": [
        "mode-by-mode source-hit recall evidence when accepted rows cover fts/vector/hybrid",
        "latency and fallback accounting for the measured dataset split",
        "embedding candidate governance evidence without changing the default baseline"
      ],
      "does_not_prove": [
        "end-to-end answer correctness",
        "global token/cost savings",
        "default embedding model superiority without install-friction and cache/disk gates"
      ],
      "artifact_requirements": [
        "run_manifest.json",
        "dataset.manifest.json",
        "report.md",
        "results"
      ],
      "required_result_fields": [
        "query_id",
        "query_type",
        "mode",
        "model_id",
        "expected_source_ids",
        "retrieved_source_ids",
        "recall_at_1",
        "recall_at_5",
        "recall_at_10",
        "p50_ms",
        "p95_ms",
        "fallback_reason",
        "token_cost_estimate",
        "accepted",
        "acceptance_notes"
      ]
    },
    {
      "id": "storage_v2_baseline",
      "title": "Storage v2 Baseline",
      "purpose": "Establish deterministic synthetic corpus generation and legacy v3 backend baseline artifact fields before Storage v2 changes defaults.",
      "proves": [
        "fixed synthetic corpus seed, entry mix, payload size, project count, and dataset hash",
        "artifact schema for ingest/search/wake/storage baseline measurements",
        "that v4.0.0 benchmark smoke does not switch the default storage backend"
      ],
      "does_not_prove": [
        "public Storage v2 speedup",
        "production million-row performance",
        "Rust hot-path readiness"
