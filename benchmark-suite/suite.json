    {
      "id": "functional_token_economics",
      "title": "Functional Token Economics",
      "purpose": "Measure feature-level fixture context-token economics for progressive recall, file-context preflight, compact wake, and wiki compact index workflows.",
      "proves": [
        "bounded fixture payload token reductions for declared progressive-disclosure workflows",
        "which feature-level token-economics claims are safe to phrase",
        "that global token/cost savings remain a separate claim gate"
      ],
      "does_not_prove": [
        "global harness-mem token/cost savings",
        "real billing savings",
        "live-agent behavior in every client",
        "code-intelligence performance comparable to Smart Explore or codedb-mcp"
      ],
