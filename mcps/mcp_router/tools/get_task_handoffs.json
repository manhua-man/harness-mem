{
  "name": "get_task_handoffs",
  "description": "Return recent task handoffs for a project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "project_name": {
        "type": "string",
        "description": "Project name"
      },
      "limit": {
        "type": "integer",
        "description": "Max handoffs to return (default 5)",
        "default": 5
      }
    },
    "required": [
      "project_name"
    ]
  }
}