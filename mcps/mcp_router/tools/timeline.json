{
  "name": "timeline",
  "description": "Return chronological observation timeline for a project.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "project_name": {
        "type": "string",
        "description": "Project name"
      },
      "limit": {
        "type": "integer",
        "description": "Max observations to return (default 50)",
        "default": 50
      }
    },
    "required": [
      "project_name"
    ]
  }
}