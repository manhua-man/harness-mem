{
  "schema_version": 1,
  "project": "harness-mem",
  "claims": [
    {
      "id": "codex_cleanup_liveness",
      "description": "Native cleanup retains active, reactivated, and unknown Codex tasks and deletes only a definitively inactive task.",
      "required": true,
      "checks": [
        {
          "id": "isolated_codex_liveness_runtime",
          "description": "Exercise real OS writer locks, Codex task-state SQLite, plan/claim recheck, and native deletion in an isolated Codex layout.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.qualification.cleanup_liveness_outcome_probe"],
          "expect": {
            "exit_code": 0,
            "json": {
              "verified": {"equals": true},
              "active_writer_retained": {"equals": true},
              "active_task_retained": {"equals": true},
              "inactive_task_deleted": {"equals": true},
              "reactivation_before_claim_retained": {"equals": true},
              "unknown_liveness_retained": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "archive_distill_batch_outcome",
      "description": "An archived Codex task completes through canonical distill with a formal Answer Packet, per-fact promotion report, Note, ledger, retrieval, replay skip, and safe source deletion.",
      "required": true,
      "checks": [
        {
          "id": "isolated_archive_distill_runtime",
          "description": "Execute the real archive adapter and canonical worker against an isolated durable store with only the model decision made deterministic.",
          "evidence_tier": "direct",
          "timeout_seconds": 120,
          "command": ["{python}", "-m", "harness_mem.qualification.archive_distill_outcome_probe"],
          "expect": {
            "exit_code": 0,
            "json": {
              "verified": {"equals": true},
              "batch_completed": {"equals": true},
              "answer_packet_persisted": {"equals": true},
              "question_is_session_question": {"equals": true},
              "promotion_visible": {"equals": true},
              "note_materialized": {"equals": true},
              "note_byte_hash_matches": {"equals": true},
              "ledger_persisted": {"equals": true},
              "replay_skipped": {"equals": true},
              "truth_retrievable": {"equals": true},
              "semantic_verification_executed": {"equals": true},
              "sqlite_authority_persists_without_markdown": {"equals": true},
              "markdown_projection_is_clean": {"equals": true},
              "markdown_deletion_does_not_change_retrieval": {"equals": true},
              "safe_source_cleanup_reported": {"equals": true},
              "safe_source_deleted": {"equals": true},
              "source_cleanup_status": {"equals": "deleted"},
              "run_verification_passed": {"equals": true},
              "run_receipt_persisted": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "codex_hook_lifecycle",
      "description": "A built wheel installs the one hm entry without changing a project, and first use installs the project Hooks and reports Codex's trust step; Codex Desktop native start and post-turn hooks each have a fresh receipt for the current configuration.",
      "required": true,
      "checks": [
        {
          "id": "fresh_install_and_first_use",
          "description": "Install-time smoke proves Codex Quickstart adds only hm, MCP initialization leaves the project untouched, and the first Codex status call specified by the installed hm entry installs Codex Hooks and reports the native trust step.",
          "evidence_tier": "direct",
          "timeout_seconds": 120,
          "command": ["{python}", "code/scripts/smoke_fresh_install.py", "--expected-version", "v0.9.27"],
          "expect": {
            "exit_code": 0,
            "json": {
              "verified": {"equals": true},
              "only_hm_entry_installed": {"equals": true},
              "hm_entry_contract_complete": {"equals": true},
              "quickstart_project_untouched": {"equals": true},
              "mcp_initialize_project_untouched": {"equals": true},
              "single_host_flow": {"equals": true},
              "first_status_project_ready": {"equals": true},
              "first_status_hooks_installed": {"equals": true},
              "codex_hook_trust_step_reported": {"equals": true}
            }
          }
        },
        {
          "id": "native_receipts",
          "description": "Inspect both native hook actions against the current hook fingerprint. Their global latest receipts may belong to interleaved Desktop tasks.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.outcome_probe", "--project", "harness-mem", "--project-root", "{project_root}", "--client", "codex"],
          "expect": {
            "exit_code": 0,
            "json": {
              "hooks.configuration_complete": {"equals": true},
              "hooks.wake_verified": {"equals": true},
              "hooks.maintenance_verified": {"equals": true},
              "hooks.actions_verified": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "dream_execution",
      "description": "Dream has a successful persisted run within the verification window.",
      "required": true,
      "checks": [
        {
          "id": "persisted_dream_run",
          "description": "Read the durable Dream ledger rather than scheduler configuration.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.outcome_probe", "--project", "harness-mem", "--project-root", "{project_root}", "--client", "codex"],
          "expect": {
            "exit_code": 0,
            "json": {
              "dream.successful_run_count": {"gte": 1},
              "dream.last_successful_run_at": {"exists": true},
              "dream.success_within_window": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "distill_user_artifacts",
      "description": "Every recently completed session distill has a readable job-bound Session Note, or an explicit audited-unavailable status when historical source identity and Note evidence were already pruned.",
      "required": true,
      "checks": [
        {
          "id": "completed_session_notes",
          "description": "Match completed distill jobs to real user-readable Note files and keep irrecoverable historical gaps explicit rather than inventing Notes.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.outcome_probe", "--project", "harness-mem", "--project-root", "{project_root}", "--client", "codex"],
          "expect": {
            "exit_code": 0,
            "json": {
              "distill.unique_completed_sessions": {"gte": 1},
              "distill.note_coverage_complete": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "background_memory_hook_flow",
      "description": "One isolated Hook run uses the selected host CLI, writes a job-bound Note and SQLite knowledge, returns that same knowledge through normal search, blocks Hook reentry, and does not put the synthetic run in the user's real data or Note directories.",
      "required": true,
      "checks": [
        {
          "id": "isolated_background_memory_runtime",
          "description": "Trigger the installed Hook and worker against isolated data, then verify the same job, Note, knowledge, normal search result, and three blocked Hook calls.",
          "evidence_tier": "direct",
          "timeout_seconds": 1200,
          "command": ["{python}", "code/scripts/run_release_hook_acceptance.py", "--hook-client", "cursor", "--output", "{project_root}/.tmp/release-hook-acceptance-isolated.json"],
          "expect": {
            "exit_code": 0,
            "json": {
              "hook_exit_code": {"equals": 0},
              "model_check.status": {"equals": "passed"},
              "full_hook_started": {"equals": true},
              "provider_matches_selected_cli": {"equals": true},
              "runtime_current": {"equals": true},
              "config_current": {"equals": true},
              "lifecycle_verified": {"equals": true},
              "provider_isolated": {"equals": true},
              "persistence.job_status": {"equals": "completed"},
              "persistence.bound_truth_count": {"gte": 1},
              "persistence.sqlite_truth_count": {"gte": 1},
              "persistence.normal_search_hit": {"equals": true},
              "isolation.data_dir_isolated": {"equals": true},
              "isolation.notes_dir_isolated": {"equals": true},
              "isolation.real_ledger_run_absent": {"equals": true},
              "isolation.real_note_absent": {"equals": true},
              "autonomous.execution_source": {"equals": "autonomous_worker"},
              "autonomous.note_verified": {"equals": true},
              "autonomous.hook_guard_check.all_blocked": {"equals": true},
              "autonomous.hook_guard_check.downstream_jobs_created": {"equals": 0}
            }
          }
        }
      ]
    },
    {
      "id": "partial_distill_handoff",
      "description": "Partial distill promotes an independently Answered candidate, persists a job-bound handoff, blocks Dream, and writes separate immutable/latest Notes.",
      "required": true,
      "checks": [
        {
          "id": "isolated_partial_distill_runtime",
          "description": "Execute and read back the real govern/finalize path in an isolated durable store.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.qualification.distill_outcome_probe"],
          "expect": {
            "exit_code": 0,
            "json": {
              "verified": {"equals": true},
              "partial_candidate_promoted": {"equals": true},
              "handoff_persisted": {"equals": true},
              "handoff_job_bound": {"equals": true},
              "dream_blocked_for_partial": {"equals": true},
              "immutable_note_exists": {"equals": true},
              "latest_note_exists": {"equals": true},
              "note_paths_distinct": {"equals": true}
            }
          }
        }
      ]
    },
    {
      "id": "distill_acceptance_matrix",
      "description": "The versioned F1-F11 fixture catalog maps every A1-E6 path and the read-only F8-F11 shadow contract to executable results.",
      "required": true,
      "checks": [
        {
          "id": "distill_acceptance_runner",
          "description": "Run all 28 mapped paths, including the zero-mutation F8-F11 shadow checks, and produce a machine-readable report. The Hook check owns the single model preflight and full background run.",
          "evidence_tier": "direct",
          "timeout_seconds": 300,
          "command": ["{python}", "-m", "harness_mem.qualification.distill_acceptance", "--project-root", "{project_root}", "--output", "{project_root}/.codex/distill-acceptance-report.json"],
          "expect": {
            "exit_code": 0,
            "json": {
              "status": {"equals": "passed"},
              "l1.passed": {"equals": 28},
              "l1.total": {"equals": 28},
              "model_samples.status": {"equals": "not_run"}
            }
          }
        }
      ]
    },
    {
      "id": "multi_point_memory_assimilation",
      "description": "One autonomous session independently adds a new memory, confirms existing truth without duplication, rejects a one-off request, creates a job-bound handoff, and makes a rule normally retrievable through the bounded second semantic call.",
      "required": true,
      "checks": [
        {
          "id": "isolated_multi_point_assimilation_runtime",
          "description": "Run the real snapshot, worker, evidence revalidation, second provider call, governed apply, Note/Answer Packet, retrieval, wake, and replay path in an isolated durable store.",
          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.qualification.memory_assimilation_outcome_probe"],
          "expect": {
            "exit_code": 0,
            "json": {
              "multi_point_independent": {"equals": true},
              "add_retrievable": {"equals": true},
              "confirm_has_no_duplicate": {"equals": true},
              "one_off_request_not_written": {"equals": true},
              "handoff_job_bound": {"equals": true},
              "rule_materialized_and_normally_retrievable": {"equals": true},
              "terminal_processing_material_cleaned": {"equals": true},
              "answer_packet_point_bound": {"equals": true},
              "assimilation_provider_isolated": {"equals": true},
              "verification_provider_executed_once": {"equals": true},
              "replay_no_provider_recall": {"equals": true},
              "verified": {"equals": true}
            }
