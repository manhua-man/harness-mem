          "evidence_tier": "direct",
          "command": ["{python}", "-m", "harness_mem.qualification.clean_retrieval_outcome_probe"],
          "expect": {
            "exit_code": 0,
            "json": {
              "default_current_truth_retrievable": {"equals": true},
              "default_excludes_provisional_and_historical": {"equals": true},
              "default_has_no_raw_observation": {"equals": true},
              "default_has_no_audit_metadata": {"equals": true},
              "deep_recall_returns_raw_observation": {"equals": true},
              "wake_default_has_no_raw_observation": {"equals": true},
              "wake_deep_recall_returns_raw_observation": {"equals": true},
              "verified": {"equals": true}
            }
          }
        }
